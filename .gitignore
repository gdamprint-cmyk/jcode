/target
Cargo.lock
__pycache__/
/.wrangler/
/tmp/
# Local onboarding sandbox + auth fixtures. May contain REAL OAuth tokens copied
# from $HOME (see scripts/onboarding_sandbox.sh seed-real-logins). Never commit.
/.tmp/
/.jcode/generated-images/
/telemetry-worker/backups/
target-ttest/
target-ttest*/

# Local capture artefacts are not committed baselines.
captures/

# Stray experiment/debug artifacts at the repo root. Real assets live under
# assets/, docs/, and tests/ and are committed explicitly.
/*.log
/*.avif
/*.mp4
/*.png

# Local tool state. These are generated indexes and scratch trees, never
# source, and they are large enough to dominate an untracked-file listing.
# .cgrep/ = the cgrep tantivy index, graft/ = the graft code graph cards,
# .serena/ = the serena project config.
/.cgrep/
/graft/
/.serena/
/nul)

# Local scratch from earlier validation runs, and a ripgrep-only config that
# re-admits the gitignored graft/ tree for searching.
/_val4_cfc_files.txt
/.ignore

# Local Claude Code settings written by `entire enable` / `entire graph setup`
# (the SubagentStart hook). Tool state, never source. Also listed in
# .brainignore, but the Brain repository-context seed gates on git status, so
# the file has to be ignored by git itself for the seed to build.
/.claude/settings.local.json

# Validation-suite scratch output. Regenerated by the scripts under scripts/entire/,
# never a committed baseline.
*.out

# Session/agent scratch dumps at the repo root and under research/. These are
# command captures, log extracts and probe output written by live agent
# sessions, not source, and they dominated the untracked listing.
/out_*.txt
/promote*.json
/stash_*.txt
/nil
/server_help.txt
/path_matrix_final.txt
/probe_live_identity.ps1
/win_diff.patch
/t2.txt
/t3.txt
/test_out.txt
/wt.txt
/crates/jcode-tui/.cgrep/
/research/_*.txt
/research/cargo_*.txt
/research/check_out.txt
/research/cv*-reconcile-*.txt
/research/run_tests_status.txt
/research/test_*_out.txt

# A stray zero-byte file named 746 that some earlier run left in the repo
# root. Provenance was never established, so it is ignored rather than
# deleted - see artifact-stray-746-provenance.md. Listed here as well as
# in .brainignore because the Brain matcher and git are separate gates.
/746
