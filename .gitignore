/target
Cargo.lock
__pycache__/
ios_simulator_screenshot.png
/.wrangler/
/tmp/
# Local onboarding sandbox + auth fixtures. May contain REAL OAuth tokens copied
# from $HOME (see scripts/onboarding_sandbox.sh seed-real-logins). Never commit.
/.tmp/
/.jcode/generated-images/
/telemetry-worker/backups/
target-ttest/
target-ttest*/

# Local capture artefacts are not committed baselines.
captures/

# Stray experiment/debug artifacts at the repo root. Real assets live under
# assets/, docs/, ios/, and tests/ and are committed explicitly.
/*.log
/*.avif
/*.mp4
/*.png

# Local tool state. These are generated indexes and scratch trees, never
# source, and they are large enough to dominate an untracked-file listing.
# .cgrep/ = the cgrep tantivy index, graft/ = the graft code graph cards,
# .serena/ = the serena project config.
/.cgrep/
/graft/
/.serena/
/nul)

# Local scratch from earlier validation runs, and a ripgrep-only config that
# re-admits the gitignored graft/ tree for searching.
/_val4_cfc_files.txt
/.ignore

# Local tool state written by `entire enable` / `entire graph setup`: the
# per-user Claude Code SubagentStart hook. Never source, and an untracked
# path here makes the Entire brain refuse to build repository context.
/.claude/settings.local.json
